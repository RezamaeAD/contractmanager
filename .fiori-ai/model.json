                                    "endDate"
                                ]
                            },
                            {
                                "title": "Customers",
                                "id": "customersSection",
                                "isTableSection": true,
                                "fields": [
                                    "Customers/name",
                                    "Customers/identificationNumber",
                                    "Customers/address",
                                    "Customers/contactInformation"
                                ]
                            }
                        ],
                        "tabs": [
                            {
